rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.admin == true;
    }

    function owns(data) {
      return isSignedIn()
        && (
          data.authorId == request.auth.uid
          || data.ownerId == request.auth.uid
        );
    }

    function keepsAuthorId() {
      return request.resource.data.authorId == resource.data.authorId;
    }

    function keepsOwnerId() {
      return !('ownerId' in resource.data)
        || request.resource.data.ownerId == resource.data.ownerId;
    }

    function onlySoftDeletesSongbook() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'deleted',
        'deletedAt',
        'lastUpdateDate'
      ]);
    }

    function onlySoftDeletesRelation() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'deleted',
        'deletedAt'
      ]);
    }

    function songbookExists(songbookId) {
      return exists(/databases/$(database)/documents/songbooks/$(songbookId));
    }

    function songbookOwner(songbookId) {
      return isSignedIn()
        && songbookExists(songbookId)
        && (
          get(/databases/$(database)/documents/songbooks/$(songbookId)).data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/songbooks/$(songbookId)).data.ownerId == request.auth.uid
        );
    }

    function songbookIsTemplate(songbookId) {
      return songbookExists(songbookId)
        && get(/databases/$(database)/documents/songbooks/$(songbookId)).data.isTemplate == true;
    }

    function songExists(songId) {
      return exists(/databases/$(database)/documents/songs/$(songId));
    }

    function relationOwner(data) {
      return isSignedIn()
        && songbookIsTemplate(data.songbookId) == false
        && (
          data.author_uid == request.auth.uid
          || data.ownerId == request.auth.uid
          || songbookOwner(data.songbookId)
        );
    }

    match /songs/{songId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin()
        || (owns(resource.data)
        && keepsAuthorId()
        && keepsOwnerId());
      allow delete: if isAdmin() || owns(resource.data);
    }

    // Fragmentos derivados de `songs`. Cualquiera que pueda crear una cancion debe poder
    // mantenerlos en la misma escritura por lotes; el contenido se reconstruye con el script
    // de reindexado si un cliente los deja inconsistentes.
    match /song_index/{shardId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasAll(['shard', 'count', 'songs', 'updatedAt'])
        && request.resource.data.songs is list;
    }

    match /song_search_index/{shardId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasAll(['shard', 'count', 'entries', 'updatedAt'])
        && request.resource.data.entries is list;
    }

    match /songbooks/{songbookId} {
      allow read: if isAdmin()
        || owns(resource.data)
        || (resource.data.scope == 'shared' && resource.data.published == true);
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.scope == 'personal'
        && request.resource.data.published == false
        && request.resource.data.isTemplate == false;
      allow update: if isAdmin()
        || (owns(resource.data)
          && resource.data.isTemplate != true
          && onlySoftDeletesSongbook())
        || (owns(resource.data)
          && resource.data.isTemplate != true
          && request.resource.data.isTemplate != true
          && keepsAuthorId()
          && keepsOwnerId());
      allow delete: if isAdmin()
        || (owns(resource.data) && resource.data.isTemplate != true);
    }

    match /songbook_groups/{groupId} {
      allow read: if resource.data.published == true
        || isAdmin()
        || owns(resource.data);
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (owns(resource.data) && resource.data.scope == 'personal');
    }

    match /songbook_group_members/{memberId} {
      allow read: if isAdmin()
        || resource.data.groupPublic == true
        || (isSignedIn() && resource.data.groupOwnerId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.groupOwnerId == request.auth.uid);
    }

    match /songbook_songs/{relationId} {
      allow read: if isAdmin()
        || songbookOwner(resource.data.songbookId)
        || resource.data.songbookPublic == true;
      allow create: if isSignedIn()
        && request.resource.data.author_uid == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && songbookExists(request.resource.data.songbookId)
        && songExists(request.resource.data.songId)
        && (isAdmin() || songbookOwner(request.resource.data.songbookId))
        && (
          isAdmin()
          || songbookIsTemplate(request.resource.data.songbookId) == false
        );
      allow update: if isAdmin()
        || (relationOwner(resource.data)
          && onlySoftDeletesRelation())
        || (relationOwner(resource.data)
        && request.resource.data.songbookId == resource.data.songbookId
        && request.resource.data.songId == resource.data.songId
        && request.resource.data.author_uid == resource.data.author_uid
        && (
          !('ownerId' in resource.data)
          || request.resource.data.ownerId == resource.data.ownerId
        ));
      allow delete: if isAdmin() || relationOwner(resource.data);
    }

    match /songbook_suggestions/{suggestionId} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isAdmin()
        || (owns(resource.data)
          && resource.data.status == 'open'
          && request.resource.data.status == 'rejected'
          && request.resource.data.authorId == resource.data.authorId);
      allow delete: if isAdmin();
    }

    match /song_suggestions/{suggestionId} {
      allow read: if isAdmin() || owns(resource.data);
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'open'
        && songExists(request.resource.data.targetSongId);
      allow update: if isAdmin()
        || (owns(resource.data)
          && resource.data.status == 'open'
          && request.resource.data.status == 'open'
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.targetSongId == resource.data.targetSongId);
      allow delete: if isAdmin() || (owns(resource.data) && resource.data.status == 'open');
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['type', 'status', 'title', 'message', 'creationDate'])
        && request.resource.data.type in ['bug', 'idea']
        && request.resource.data.status == 'open'
        && (!('authorId' in request.resource.data) || request.resource.data.authorId == null || (isSignedIn() && request.resource.data.authorId == request.auth.uid))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 10000;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin()
        || (owns(resource.data)
        && keepsAuthorId()
        && keepsOwnerId());
      allow delete: if isAdmin() || owns(resource.data);
    }

    match /users/{uid} {
      allow read, write: if isSignedIn()
        && request.auth.uid == uid;
    }

    match /event_types/{eventTypeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin()
        || (owns(resource.data)
        && keepsAuthorId()
        && keepsOwnerId());
      allow delete: if isAdmin() || owns(resource.data);
    }

    match /event_slots/{slotId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin()
        || (owns(resource.data)
        && keepsAuthorId()
        && keepsOwnerId());
      allow delete: if isAdmin() || owns(resource.data);
    }

    match /repertoires/{repertoireId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin()
        || (owns(resource.data)
        && keepsAuthorId()
        && keepsOwnerId());
      allow delete: if isAdmin() || owns(resource.data);
    }

    match /repertoire_groups/{groupId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin()
        || (owns(resource.data)
        && keepsAuthorId()
        && keepsOwnerId());
      allow delete: if isAdmin() || owns(resource.data);
    }

    match /repertoire_group_members/{memberId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin()
        || (owns(resource.data)
        && keepsAuthorId()
        && keepsOwnerId());
      allow delete: if isAdmin() || owns(resource.data);
    }

    match /repertoire_songs/{repertoireSongId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin()
        || (owns(resource.data)
        && keepsAuthorId()
        && keepsOwnerId());
      allow delete: if isAdmin() || owns(resource.data);
    }
  }
}
