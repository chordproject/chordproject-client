{
  "name": "chordproject-client",
  "version": "1.0.0",
  "private": true,
  "description": "A web client for the ChordProject",
  "keywords": [
    "chordpro",
    "angular",
    "firebase",
    "chordproject"
  ],
  "homepage": "https://chordproject.com",
  "author": "Jaime Mora (jrmora)",
  "scripts": {
    "build": "ng build --configuration=production",
    "build:prod": "ng build --configuration=production --aot",
    "build-hj": "ng build --configuration=hj",
    "backup:hj": "npm run backup:hj:test && npm run backup:hj:full",
    "backup:hj:full": "node scripts/backup-firestore.mjs --project homenajesus-app --collections event_slots,event_types,repertoire_songs,repertoires,songbook_songs,songbooks,songs",
    "backup:hj:test": "node scripts/backup-firestore.mjs --project homenajesus-app --collections songs,songbooks,songbook_songs --limit 5 --out backups/firestore-homenajesus-app-test",
    "deploy:chp": "npm run build:prod && npm_config_cache=${TMPDIR:-/tmp}/npm-cache npx firebase-tools deploy --project chp --only hosting:chp",
    "deploy:hj": "npm run build-hj && npm_config_cache=${TMPDIR:-/tmp}/npm-cache npx firebase-tools deploy --project hj --only hosting:hj",
    "lint": "ng lint",
    "ng": "ng",
    "release": "npm run deploy:chp && npm run deploy:hj",
    "set-admin-claim": "node scripts/set-admin-claim.mjs --project homenajesus-app",
    "start": "npm run start-chp",
    "start-chp": "sh -c 'pids=$(lsof -tiTCP:3873 -sTCP:LISTEN 2>/dev/null); if [ -n \"$pids\" ]; then kill $pids 2>/dev/null || true; fi; exec ng serve --no-hmr --configuration=chp --port=3873 \"$@\"' --",
    "start-hj": "sh -c 'pids=$(lsof -tiTCP:3873 -sTCP:LISTEN 2>/dev/null); if [ -n \"$pids\" ]; then kill $pids 2>/dev/null || true; fi; exec ng serve --no-hmr --configuration=hj --port=3873 \"$@\"' --",
    "test": "ng test",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/aria": "22.1.1",
    "@angular/cdk": "22.1.1",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/material": "22.1.1",
    "@angular/material-date-fns-adapter": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-server": "22.1.1",
    "@angular/router": "22.1.1",
    "@angular/ssr": "22.1.3",
    "@fullcalendar/angular": "7.0.2",
    "@fullcalendar/rrule": "7.0.2",
    "@jsverse/transloco": "8.4.0",
    "angular-split": "20.0.0",
    "apexcharts": "5.16.0",
    "chordproject-editor": "0.1.11",
    "chordproject-parser": "1.0.4",
    "chroma-js": "3.2.0",
    "date-fns": "4.4.0",
    "express": "5.2.1",
    "firebase": "12.18.0",
    "fullcalendar": "7.0.2",
    "hsluv": "1.0.2",
    "ng-apexcharts": "2.5.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/chroma-js": "3.1.2",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "angular-eslint": "22.1.0",
    "eslint": "10.8.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-jsdoc": "64.0.2",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "firebase-admin": "^14.3.0",
    "globals": "17.9.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
